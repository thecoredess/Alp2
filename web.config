<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hanya public/ sepatutnya terdedah kepada web. Oleh kerana folder aplikasi
  berada di bawah wwwroot, fail dalaman (.env, dump SQL, skrip, log) boleh
  dicapai terus melalui HTTP. Peraturan di bawah menyekatnya.

  Ini adalah lapisan pertahanan kedua — cara paling selamat tetap menetapkan
  Physical Path aplikasi IIS terus ke folder public\.
-->
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />

        <rewrite>
            <rules>
                <rule name="Sekat folder dalaman Laravel" stopProcessing="true">
                    <match url="^(app|bootstrap|config|database|docs|lang|node_modules|resources|routes|scripts|storage|tests|vendor|URS|_reference_legacy)(/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Akses ditolak." />
                </rule>

                <rule name="Sekat fail sensitif" stopProcessing="true">
                    <match url="(^|/)(\.env.*|\.git.*|artisan|composer\.(json|lock|phar)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|.*\.(sql|log|md|bak|ps1))$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Akses ditolak." />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
