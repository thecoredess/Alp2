<?xml version="1.0" encoding="UTF-8"?>
<!--
  Padanan IIS bagi public/.htaccess (Apache). IIS tidak membaca .htaccess,
  jadi tanpa fail ini semua laluan Laravel selain index.php menjadi 404.
-->
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <remove value="index.php" />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <directoryBrowse enabled="false" />

        <!-- Biarkan halaman ralat Laravel keluar; jika tidak IIS menggantikannya. -->
        <httpErrors existingResponse="PassThrough" />

        <rewrite>
            <rules>
                <rule name="Laravel front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
